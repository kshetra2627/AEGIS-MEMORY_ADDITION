# Aegis — Example environment configuration
# Copy this file to .env and fill in your actual values.
# Never commit .env or any file containing real API keys.

# ── LLM Providers (Groq → Gemini → OpenRouter failover) ──────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── RAG / Embedding ───────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.65
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Hindsight Memory Integration ─────────────────────────────────────────
# Official Hindsight Cloud API endpoint (or your self-hosted server URL).
# Self-hosted default: http://localhost:8888
# Cloud (managed):     https://api.hindsight.vectorize.io
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io

# Bearer token from the Hindsight Cloud dashboard (ui.hindsight.vectorize.io)
# or from your self-hosted server configuration.
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Memory bank identifier — one per organisation.
# Use a descriptive slug; it is created automatically on first use.
HINDSIGHT_BANK_ID=aegis-northwind

# Set to "false" to disable all memory features.
# When false, Aegis behaves exactly like the pre-Hindsight baseline.
MEMORY_ENABLED=true

# Number of past cases to recall per query (default: 5, max: 10).
MEMORY_TOP_K=5

# Per-request timeout in seconds for Hindsight API calls.
# If Hindsight times out, Aegis continues without memory.
MEMORY_TIMEOUT_SECONDS=5
